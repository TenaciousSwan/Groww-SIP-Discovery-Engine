# --- Apify (Reddit & YouTube scraping) ---
# Get your token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_DNPVzy1GruE4ZhgmxW23Wa8GvLu7Fv4C4T5n

# --- Google Gemini (AI classification) ---
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6J4P0MNbK-__q_4bmqlY1sHxl3YGQJtZ-CrX1uM6A1e5g

# --- YouTube Data API (optional, only if not using Apify for YouTube) ---
# Get your key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Ollama (local AI classification) ---
# qwen2.5:1.5b = fast (~8s/record), qwen2.5:7b = slower but deeper (~50s/record)
OLLAMA_MODEL=qwen2.5:1.5b

# --- Backend preference ---
# Options: "gemini" (faster, cloud) | "ollama" (local, private)
PREFER_BACKEND=gemini
